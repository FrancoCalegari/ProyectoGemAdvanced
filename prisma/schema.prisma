datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum estado_titulo {
  ACTIVO
  DE_BAJA
}

enum estado_resolucion {
  VIGENTE
  CERRADA
}

enum tipo_cursada {
  ANUAL
  CUATRIMESTRAL_1
  CUATRIMESTRAL_2
}

enum tipo_correlatividad {
  PARA_CURSAR
  PARA_RENDIR_FINAL
}

enum estado_inscripcion {
  ACTIVA
  EGRESADO
  BAJA
}

enum estado_cursada {
  EN_CURSO
  REGULAR
  APROBADA
  LIBRE
  DESAPROBADA
}

enum tipo_certificado {
  PARCIAL_ANIO
  TITULO_COMPLETO
}

enum estado_certificado {
  EMITIDO
  ANULADO
}

enum estado_examen {
  PENDIENTE
  APROBADO
  DESAPROBADO
}

enum rol_usuario {
  ADMIN
  SECRETARIA
  ALUMNO
}

// -------------------------------------------------------------
// MODELOS
// -------------------------------------------------------------

model Titulo {
  id            String         @id @default(uuid()) @db.Uuid
  nombre        String         @unique
  nivel         String
  duracionAnios Int            @map("duracion_anios")
  estado        estado_titulo  @default(ACTIVO)

  resoluciones  Resolucion[]
  inscripciones Inscripcion[]
  certificados  Certificado[]

  @@map("titulos")
}

model Resolucion {
  id                  String            @id @default(uuid()) @db.Uuid
  tituloId            String            @map("titulo_id") @db.Uuid
  numero              String
  anioCreacion        Int               @map("anio_creacion")
  codigo              String            @unique
  fechaInicioVigencia DateTime          @map("fecha_inicio_vigencia") @db.Date
  fechaFinVigencia    DateTime?         @map("fecha_fin_vigencia") @db.Date
  estado              estado_resolucion @default(VIGENTE)
  observaciones       String?           @db.Text

  titulo              Titulo            @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  aniosCurriculares   AnioCurricular[]
  inscripciones       Inscripcion[]
  certificados        Certificado[]

  @@unique([tituloId, codigo])
  @@map("resoluciones")
}

model AnioCurricular {
  id           String        @id @default(uuid()) @db.Uuid
  resolucionId String        @map("resolucion_id") @db.Uuid
  numeroAnio   Int           @map("numero_anio")
  nombre       String

  resolucion   Resolucion    @relation(fields: [resolucionId], references: [id], onDelete: Cascade)
  materias     Materia[]
  certificados Certificado[]

  @@unique([resolucionId, numeroAnio])
  @@map("anios_curriculares")
}

model Materia {
  id               String         @id @default(uuid()) @db.Uuid
  anioCurricularId String         @map("anio_curricular_id") @db.Uuid
  nombre           String
  codigo           String
  cargaHoraria     Int            @map("carga_horaria")
  tipoCursada      tipo_cursada   @map("tipo_cursada")

  anioCurricular   AnioCurricular @relation(fields: [anioCurricularId], references: [id], onDelete: Cascade)

  correlativasParaEsta   Correlatividad[] @relation("MateriaRequisito")
  esCorrelativaDe        Correlatividad[] @relation("MateriaExigida")
  cursadas               CursadaMateria[]
  equivalenciasOrigen    Equivalencia[]   @relation("EquivalenciaOrigen")
  equivalenciasDestino   Equivalencia[]   @relation("EquivalenciaDestino")

  @@unique([anioCurricularId, codigo])
  @@map("materias")
}

model Correlatividad {
  id                 String              @id @default(uuid()) @db.Uuid
  materiaId          String              @map("materia_id") @db.Uuid
  materiaRequeridaId String              @map("materia_requerida_id") @db.Uuid
  tipo               tipo_correlatividad

  materia            Materia             @relation("MateriaRequisito", fields: [materiaId], references: [id], onDelete: Cascade)
  materiaRequerida   Materia             @relation("MateriaExigida", fields: [materiaRequeridaId], references: [id], onDelete: Cascade)

  @@unique([materiaId, materiaRequeridaId, tipo])
  @@map("correlatividades")
}

model Equivalencia {
  id               String   @id @default(uuid()) @db.Uuid
  materiaOrigenId  String   @map("materia_origen_id") @db.Uuid
  materiaDestinoId String   @map("materia_destino_id") @db.Uuid
  observaciones    String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  materiaOrigen    Materia  @relation("EquivalenciaOrigen", fields: [materiaOrigenId], references: [id], onDelete: Cascade)
  materiaDestino   Materia  @relation("EquivalenciaDestino", fields: [materiaDestinoId], references: [id], onDelete: Cascade)

  @@unique([materiaOrigenId, materiaDestinoId])
  @@map("equivalencias")
}

model Alumno {
  id                 String   @id @default(uuid()) @db.Uuid
  dni                String   @unique
  nombre             String
  apellido           String
  email              String   @unique
  fechaNacimiento    DateTime @map("fecha_nacimiento") @db.Date

  domicilioCalle     String?  @map("domicilio_calle")
  domicilioNumero    String?  @map("domicilio_numero")
  domicilioCiudad    String?  @map("domicilio_ciudad")
  domicilioProvincia String?  @map("domicilio_provincia")
  domicilioCP        String?  @map("domicilio_cp")

  tienePartidaNacimiento   Boolean @default(false) @map("tiene_partida_nacimiento")
  tieneAnaliticoSecundario Boolean @default(false) @map("tiene_analitico_secundario")
  tieneAnaliticoIncompleto Boolean @default(false) @map("tiene_analitico_incompleto")
  tieneCertificado7mo      Boolean @default(false) @map("tiene_certificado_7mo")
  tieneCUD                 Boolean @default(false) @map("tiene_cud")

  inscripciones   Inscripcion[]
  certificados    Certificado[]
  examenes        ExamenNivelatorio[]
  usuario         Usuario?

  @@map("alumnos")
}

model ExamenNivelatorio {
  id            String        @id @default(uuid()) @db.Uuid
  alumnoId      String        @map("alumno_id") @db.Uuid
  fecha         DateTime      @db.Date
  resultado     estado_examen @default(PENDIENTE)
  nota          Decimal?      @db.Decimal(4, 2)
  observaciones String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")

  alumno        Alumno        @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@map("examenes_nivelatorios")
}

model Inscripcion {
  id                  String             @id @default(uuid()) @db.Uuid
  alumnoId            String             @map("alumno_id") @db.Uuid
  tituloId            String             @map("titulo_id") @db.Uuid
  resolucionId        String             @map("resolucion_id") @db.Uuid
  fechaInscripcion    DateTime           @default(now()) @map("fecha_inscripcion") @db.Date
  estado              estado_inscripcion @default(ACTIVA)

  esCambioCarrera     Boolean            @default(false) @map("es_cambio_carrera")
  inscripcionOrigenId String?            @map("inscripcion_origen_id") @db.Uuid

  alumno              Alumno             @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  titulo              Titulo             @relation(fields: [tituloId], references: [id], onDelete: Restrict)
  resolucion          Resolucion         @relation(fields: [resolucionId], references: [id], onDelete: Restrict)
  inscripcionOrigen   Inscripcion?       @relation("CambioCarrera", fields: [inscripcionOrigenId], references: [id])
  inscripcionesHijas  Inscripcion[]      @relation("CambioCarrera")

  cursadas            CursadaMateria[]

  @@unique([alumnoId, tituloId, resolucionId])
  @@map("inscripciones")
}

model CursadaMateria {
  id             String         @id @default(uuid()) @db.Uuid
  inscripcionId  String         @map("inscripcion_id") @db.Uuid
  materiaId      String         @map("materia_id") @db.Uuid
  estado         estado_cursada @default(EN_CURSO)
  notaCursada    Decimal?       @map("nota_cursada") @db.Decimal(4, 2)
  notaFinal      Decimal?       @map("nota_final") @db.Decimal(4, 2)
  fechaEstado    DateTime       @default(now()) @map("fecha_estado") @db.Date
  esEquivalencia Boolean        @default(false) @map("es_equivalencia")

  inscripcion    Inscripcion    @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)
  materia        Materia        @relation(fields: [materiaId], references: [id], onDelete: Restrict)

  @@unique([inscripcionId, materiaId])
  @@map("cursada_materia")
}

model Certificado {
  id               String             @id @default(uuid()) @db.Uuid
  alumnoId         String             @map("alumno_id") @db.Uuid
  tituloId         String             @map("titulo_id") @db.Uuid
  resolucionId     String             @map("resolucion_id") @db.Uuid
  tipo             tipo_certificado
  anioCurricularId String?            @map("anio_curricular_id") @db.Uuid
  fechaEmision     DateTime           @default(now()) @map("fecha_emision") @db.Date
  estado           estado_certificado @default(EMITIDO)

  alumno           Alumno             @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  titulo           Titulo             @relation(fields: [tituloId], references: [id], onDelete: Restrict)
  resolucion       Resolucion         @relation(fields: [resolucionId], references: [id], onDelete: Restrict)
  anioCurricular   AnioCurricular?    @relation(fields: [anioCurricularId], references: [id], onDelete: SetNull)

  @@map("certificados")
}

model Usuario {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String      @map("password_hash")
  nombre       String
  apellido     String
  rol          rol_usuario @default(ALUMNO)
  activo       Boolean     @default(true)
  alumnoId     String?     @unique @map("alumno_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")

  alumno       Alumno?     @relation(fields: [alumnoId], references: [id], onDelete: SetNull)

  @@map("usuarios")
}