datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum estado_titulo {
  ACTIVO
  DE_BAJA
}

enum estado_resolucion {
  VIGENTE
  CERRADA
}

enum tipo_cursada {
  ANUAL
  CUATRIMESTRAL_1
  CUATRIMESTRAL_2
}

enum tipo_correlatividad {
  PARA_CURSAR
  PARA_RENDIR_FINAL
}

enum estado_alumno {
  ACTIVO
  EGRESADO
  BAJA
  INACTIVO
}

enum estado_inscripcion {
  ACTIVA
  EGRESADO
  BAJA
}

enum estado_cursada {
  EN_CURSO
  REGULAR
  APROBADA
  LIBRE
  DESAPROBADA
}

enum tipo_certificado {
  PARCIAL_ANIO
  TITULO_COMPLETO
  CONCURRENCIA
  PARA_COLECTIVO
  LABORAL
  PARA_RENDIR
}

enum estado_certificado {
  EMITIDO
  ANULADO
}

enum estado_examen {
  PENDIENTE
  APROBADO
  DESAPROBADO
}

enum rol_usuario {
  ADMIN
  SECRETARIA
  ALUMNO
  PROFESOR
  BEDEL
  CELADOR
}

enum estado_asistencia {
  PRESENTE
  AUSENTE
  JUSTIFICADO
}

enum estado_profesor {
  ACTIVO
  SUPLENCIA
  INACTIVO
}

enum tipo_licencia {
  ENFERMEDAD
  RAZON_PARTICULAR
  ESTUDIOS_FEMENINOS
  DONACION_SANGRE
  ACCIDENTE_LABORAL
  OTRO
  CERTIFICADO_SALUD
  JUSTIFICATIVO_FALTA
}

enum turno_licencia {
  MANANA
  TARDE
  NOCHE
}

enum motivo_suspension {
  LICENCIA_PROFESOR
  FERIADO
  PARO
  CLIMA
  OTRO
}

enum estado_licencia {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum cargo_empleado {
  BEDEL
  CELADOR
  OTRO
}

enum estado_empleado {
  ACTIVO
  INACTIVO
}

enum tipo_modificacion_horario {
  ALTA
  CAMBIO
  BAJA
}

enum tipo_solicitud {
  CAMBIO_HORARIO
  AUSENCIA_PROGRAMADA
  CAMBIO_MATERIA
  OTRO
}

enum estado_solicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum tipo_titulo_profesor {
  UNIVERSITARIO
  TERCIARIO
}

enum estado_certificado_presentado {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum tipo_certificado_presentado {
  MEDICO
  LABORAL
  FAMILIAR
  OTRO
}

enum tipo_mesa {
  EXAMEN_FINAL
  INGRESO_NIVELATORIO
}

enum estado_mesa {
  PROGRAMADA
  EN_CURSO
  FINALIZADA
  CANCELADA
}

enum estado_inscripcion_mesa {
  INSCRIPTO
  PRESENTE
  AUSENTE
  CANCELADO
}

// -------------------------------------------------------------
// MODELOS
// -------------------------------------------------------------

model Titulo {
  id            String        @id @default(uuid()) @db.Uuid
  nombre        String        @unique
  nivel         String
  duracionAnios Int           @map("duracion_anios")
  estado        estado_titulo @default(ACTIVO)
  descripcion   String?       @db.Text

  resoluciones  Resolucion[]
  inscripciones Inscripcion[]
  certificados  Certificado[]

  @@map("titulos")
}

model Resolucion {
  id                  String            @id @default(uuid()) @db.Uuid
  tituloId            String            @map("titulo_id") @db.Uuid
  numero              String
  anioCreacion        Int               @map("anio_creacion")
  codigo              String            @unique
  fechaInicioVigencia DateTime          @map("fecha_inicio_vigencia") @db.Date
  fechaFinVigencia    DateTime?         @map("fecha_fin_vigencia") @db.Date
  estado              estado_resolucion @default(VIGENTE)
  observaciones       String?           @db.Text

  titulo            Titulo           @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  aniosCurriculares AnioCurricular[]
  inscripciones     Inscripcion[]
  certificados      Certificado[]

  @@unique([tituloId, codigo])
  @@map("resoluciones")
}

model AnioCurricular {
  id           String @id @default(uuid()) @db.Uuid
  resolucionId String @map("resolucion_id") @db.Uuid
  numeroAnio   Int    @map("numero_anio")
  nombre       String

  resolucion   Resolucion    @relation(fields: [resolucionId], references: [id], onDelete: Cascade)
  materias     Materia[]
  certificados Certificado[]

  @@unique([resolucionId, numeroAnio])
  @@map("anios_curriculares")
}

model Materia {
  id                String       @id @default(uuid()) @db.Uuid
  anioCurricularId  String       @map("anio_curricular_id") @db.Uuid
  nombre            String
  codigo            String
  cargaHoraria      Int          @map("carga_horaria")
  tipoCursada       tipo_cursada @map("tipo_cursada")
  descripcion       String?      @db.Text
  contenidosMinimos String?      @map("contenidos_minimos") @db.Text
  objetivos         String?      @db.Text

  anioCurricular AnioCurricular @relation(fields: [anioCurricularId], references: [id], onDelete: Cascade)

  correlativasParaEsta Correlatividad[]  @relation("MateriaRequisito")
  esCorrelativaDe      Correlatividad[]  @relation("MateriaExigida")
  cursadas             CursadaMateria[]
  equivalenciasOrigen  Equivalencia[]    @relation("EquivalenciaOrigen")
  equivalenciasDestino Equivalencia[]    @relation("EquivalenciaDestino")
  mesas                MesaExamen[]
  profesores           MateriaProfesor[]
  ClaseSuspendida      ClaseSuspendida[]

  @@unique([anioCurricularId, codigo])
  @@map("materias")
}

model Correlatividad {
  id                 String              @id @default(uuid()) @db.Uuid
  materiaId          String              @map("materia_id") @db.Uuid
  materiaRequeridaId String              @map("materia_requerida_id") @db.Uuid
  tipo               tipo_correlatividad

  materia          Materia @relation("MateriaRequisito", fields: [materiaId], references: [id], onDelete: Cascade)
  materiaRequerida Materia @relation("MateriaExigida", fields: [materiaRequeridaId], references: [id], onDelete: Cascade)

  @@unique([materiaId, materiaRequeridaId, tipo])
  @@map("correlatividades")
}

model Equivalencia {
  id               String   @id @default(uuid()) @db.Uuid
  materiaOrigenId  String   @map("materia_origen_id") @db.Uuid
  materiaDestinoId String   @map("materia_destino_id") @db.Uuid
  observaciones    String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  materiaOrigen  Materia @relation("EquivalenciaOrigen", fields: [materiaOrigenId], references: [id], onDelete: Cascade)
  materiaDestino Materia @relation("EquivalenciaDestino", fields: [materiaDestinoId], references: [id], onDelete: Cascade)

  @@unique([materiaOrigenId, materiaDestinoId])
  @@map("equivalencias")
}

model Alumno {
  id              String   @id @default(uuid()) @db.Uuid
  dni             String   @unique
  nombre          String
  apellido        String
  email           String   @unique
  fechaNacimiento DateTime @map("fecha_nacimiento") @db.Date

  domicilioCalle     String? @map("domicilio_calle")
  domicilioNumero    String? @map("domicilio_numero")
  domicilioCiudad    String? @map("domicilio_ciudad")
  domicilioProvincia String? @map("domicilio_provincia")
  domicilioCP        String? @map("domicilio_cp")

  tienePartidaNacimiento   Boolean       @default(false) @map("tiene_partida_nacimiento")
  tieneAnaliticoSecundario Boolean       @default(false) @map("tiene_analitico_secundario")
  tieneAnaliticoIncompleto Boolean       @default(false) @map("tiene_analitico_incompleto")
  tieneCertificado7mo      Boolean       @default(false) @map("tiene_certificado_7mo")
  tieneCUD                 Boolean       @default(false) @map("tiene_cud")
  estadoAlumno             estado_alumno @default(ACTIVO) @map("estado_alumno")

  inscripciones           Inscripcion[]
  certificados            Certificado[]
  examenes                ExamenNivelatorio[]
  usuario                 Usuario?
  certificadosPresentados CertificadoPresentado[]
  inscripcionesMesas      InscripcionMesa[]
  solicitudes             Solicitud[]

  @@map("alumnos")
}

model ExamenNivelatorio {
  id            String        @id @default(uuid()) @db.Uuid
  alumnoId      String        @map("alumno_id") @db.Uuid
  fecha         DateTime      @db.Date
  hora          String?
  lugar         String?
  articulo      String?       @map("articulo")
  resultado     estado_examen @default(PENDIENTE)
  nota          Decimal?      @db.Decimal(4, 2)
  observaciones String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")

  alumno     Alumno      @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  mesaExamen MesaExamen?

  @@map("examenes_nivelatorios")
}

model Inscripcion {
  id               String             @id @default(uuid()) @db.Uuid
  alumnoId         String             @map("alumno_id") @db.Uuid
  tituloId         String             @map("titulo_id") @db.Uuid
  resolucionId     String             @map("resolucion_id") @db.Uuid
  fechaInscripcion DateTime           @default(now()) @map("fecha_inscripcion") @db.Date
  estado           estado_inscripcion @default(ACTIVA)

  esCambioCarrera     Boolean @default(false) @map("es_cambio_carrera")
  inscripcionOrigenId String? @map("inscripcion_origen_id") @db.Uuid

  alumno             Alumno        @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  titulo             Titulo        @relation(fields: [tituloId], references: [id], onDelete: Restrict)
  resolucion         Resolucion    @relation(fields: [resolucionId], references: [id], onDelete: Restrict)
  inscripcionOrigen  Inscripcion?  @relation("CambioCarrera", fields: [inscripcionOrigenId], references: [id])
  inscripcionesHijas Inscripcion[] @relation("CambioCarrera")

  cursadas CursadaMateria[]

  @@unique([alumnoId, tituloId, resolucionId])
  @@map("inscripciones")
}

model CursadaMateria {
  id             String         @id @default(uuid()) @db.Uuid
  inscripcionId  String         @map("inscripcion_id") @db.Uuid
  materiaId      String         @map("materia_id") @db.Uuid
  estado         estado_cursada @default(EN_CURSO)
  notaCursada    Decimal?       @map("nota_cursada") @db.Decimal(4, 2)
  notaFinal      Decimal?       @map("nota_final") @db.Decimal(4, 2)
  fechaEstado    DateTime       @default(now()) @map("fecha_estado") @db.Date
  esEquivalencia Boolean        @default(false) @map("es_equivalencia")
  profesorId     String?        @map("profesor_id") @db.Uuid

  inscripcion Inscripcion  @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)
  materia     Materia      @relation(fields: [materiaId], references: [id], onDelete: Restrict)
  asistencias Asistencia[]
  profesor    Profesor?    @relation("ProfesorNota", fields: [profesorId], references: [id], onDelete: SetNull)

  @@unique([inscripcionId, materiaId])
  @@map("cursada_materia")
}

model Asistencia {
  id            String            @id @default(uuid()) @db.Uuid
  cursadaId     String            @map("cursada_id") @db.Uuid
  fecha         DateTime          @db.Date
  estado        estado_asistencia @default(PRESENTE)
  observaciones String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")

  cursada CursadaMateria @relation(fields: [cursadaId], references: [id], onDelete: Cascade)

  @@unique([cursadaId, fecha])
  @@map("asistencias")
}

model Certificado {
  id               String             @id @default(uuid()) @db.Uuid
  alumnoId         String             @map("alumno_id") @db.Uuid
  tituloId         String             @map("titulo_id") @db.Uuid
  resolucionId     String             @map("resolucion_id") @db.Uuid
  tipo             tipo_certificado
  anioCurricularId String?            @map("anio_curricular_id") @db.Uuid
  fechaEmision     DateTime           @default(now()) @map("fecha_emision") @db.Date
  estado           estado_certificado @default(EMITIDO)

  alumno         Alumno          @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  titulo         Titulo          @relation(fields: [tituloId], references: [id], onDelete: Restrict)
  resolucion     Resolucion      @relation(fields: [resolucionId], references: [id], onDelete: Restrict)
  anioCurricular AnioCurricular? @relation(fields: [anioCurricularId], references: [id], onDelete: SetNull)

  @@map("certificados")
}

model Usuario {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String      @map("password_hash")
  nombre       String
  apellido     String
  rol          rol_usuario @default(ALUMNO)
  activo       Boolean     @default(true)
  alumnoId     String?     @unique @map("alumno_id") @db.Uuid
  profesorId   String?     @unique @map("profesor_id") @db.Uuid
  empleadoId   String?     @unique @map("empleado_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")

  alumno                Alumno?                 @relation(fields: [alumnoId], references: [id], onDelete: SetNull)
  profesor              Profesor?               @relation(fields: [profesorId], references: [id], onDelete: SetNull)
  empleado              Empleado?               @relation(fields: [empleadoId], references: [id], onDelete: SetNull)
  certificadosAprobados CertificadoPresentado[] @relation("CertificadosAprobados")
  mesasCreadas          MesaExamen[]            @relation("MesasCreadas")
  horariosModificados   ModificacionHorario[]   @relation("HorariosModificados")

  @@map("usuarios")
}

model CertificadoPresentado {
  id              String                        @id @default(uuid()) @db.Uuid
  alumnoId        String                        @map("alumno_id") @db.Uuid
  tipo            tipo_certificado_presentado
  motivo          String                        @db.Text
  fechaDesde      DateTime                      @map("fecha_desde") @db.Date
  fechaHasta      DateTime                      @map("fecha_hasta") @db.Date
  estado          estado_certificado_presentado @default(PENDIENTE)
  observaciones   String?                       @db.Text
  aprobadoPorId   String?                       @map("aprobado_por_id") @db.Uuid
  fechaResolucion DateTime?                     @map("fecha_resolucion") @db.Date
  createdAt       DateTime                      @default(now()) @map("created_at")

  alumno      Alumno   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  aprobadoPor Usuario? @relation("CertificadosAprobados", fields: [aprobadoPorId], references: [id], onDelete: SetNull)

  @@map("certificados_presentados")
}

model MesaExamen {
  id                  String      @id @default(uuid()) @db.Uuid
  tipoMesa            tipo_mesa   @default(EXAMEN_FINAL) @map("tipo_mesa")
  materiaId           String?     @map("materia_id") @db.Uuid
  examenNivelatorioId String?     @unique @map("examen_nivelatorio_id") @db.Uuid
  fecha               DateTime    @db.Date
  hora                String
  aula                String?
  cupoMaximo          Int?        @map("cupo_maximo")
  estado              estado_mesa @default(PROGRAMADA)
  observaciones       String?     @db.Text
  creadoPorId         String?     @map("creado_por_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at")

  materia           Materia?           @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  examenNivelatorio ExamenNivelatorio? @relation(fields: [examenNivelatorioId], references: [id], onDelete: SetNull)
  creadoPor         Usuario?           @relation("MesasCreadas", fields: [creadoPorId], references: [id], onDelete: SetNull)
  inscripciones     InscripcionMesa[]

  @@index([materiaId, fecha])
  @@index([tipoMesa, fecha])
  @@map("mesas_examen")
}

model InscripcionMesa {
  id               String                  @id @default(uuid()) @db.Uuid
  mesaId           String                  @map("mesa_id") @db.Uuid
  alumnoId         String                  @map("alumno_id") @db.Uuid
  estado           estado_inscripcion_mesa @default(INSCRIPTO)
  nota             Decimal?                @db.Decimal(4, 2)
  observaciones    String?                 @db.Text
  fechaInscripcion DateTime                @default(now()) @map("fecha_inscripcion")
  fechaCancelacion DateTime?               @map("fecha_cancelacion")
  createdAt        DateTime                @default(now()) @map("created_at")

  mesa   MesaExamen @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  alumno Alumno     @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@unique([mesaId, alumnoId])
  @@map("inscripciones_mesa")
}

// =========================================================
// MÓDULOS NUEVOS — Profesores, Licencias, Solicitudes
// =========================================================

model Profesor {
  id                 String          @id @default(uuid()) @db.Uuid
  dni                String          @unique
  nombre             String
  apellido           String
  email              String          @unique
  telefono           String?
  fechaNacimiento    DateTime        @map("fecha_nacimiento") @db.Date
  genero             String?
  domicilioCalle     String?         @map("domicilio_calle")
  domicilioNumero    String?         @map("domicilio_numero")
  domicilioCiudad    String?         @map("domicilio_ciudad")
  domicilioProvincia String?         @map("domicilio_provincia")
  domicilioCP        String?         @map("domicilio_cp")
  tieneCUD           Boolean         @default(false) @map("tiene_cud")
  estado             estado_profesor @default(ACTIVO)
  createdAt          DateTime        @default(now()) @map("created_at")

  titulos               TituloProfesor[]
  materias              MateriaProfesor[]
  licencias             Licencia[]
  solicitudes           Solicitud[]
  notasCargadas         CursadaMateria[]  @relation("ProfesorNota")
  clasesSuspendidas     ClaseSuspendida[]
  reasignacionesOrigen  Reasignacion[]    @relation("ReasignacionOrigen")
  reasignacionesDestino Reasignacion[]    @relation("ReasignacionDestino")
  usuario               Usuario?

  @@map("profesores")
}

model TituloProfesor {
  id          String               @id @default(uuid()) @db.Uuid
  profesorId  String               @map("profesor_id") @db.Uuid
  tipo        tipo_titulo_profesor
  nombre      String
  institucion String
  anioEgreso  Int                  @map("anio_egreso")
  numero      String?
  archivoUrl  String?              @map("archivo_url")
  createdAt   DateTime             @default(now()) @map("created_at")

  profesor Profesor @relation(fields: [profesorId], references: [id], onDelete: Cascade)

  @@map("titulos_profesor")
}

model MateriaProfesor {
  id         String   @id @default(uuid()) @db.Uuid
  profesorId String   @map("profesor_id") @db.Uuid
  materiaId  String   @map("materia_id") @db.Uuid
  diaSemana  Int      @map("dia_semana")
  horaInicio String   @map("hora_inicio")
  horaFin    String   @map("hora_fin")
  aula       String?
  createdAt  DateTime @default(now()) @map("created_at")

  profesor Profesor @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  materia  Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  @@unique([profesorId, materiaId, diaSemana, horaInicio])
  @@map("materias_profesor")
}

model Licencia {
  id            String          @id @default(uuid()) @db.Uuid
  profesorId    String?         @map("profesor_id") @db.Uuid
  empleadoId    String?         @map("empleado_id") @db.Uuid
  tipo          tipo_licencia
  fechaDesde    DateTime        @map("fecha_desde") @db.Date
  fechaHasta    DateTime        @map("fecha_hasta") @db.Date
  todoElDia     Boolean         @default(true) @map("todo_el_dia")
  horaDesde     String?         @map("hora_desde")
  horaHasta     String?         @map("hora_hasta")
  turno         turno_licencia?
  motivo        String?         @db.Text
  estado        estado_licencia @default(PENDIENTE)
  aprobadoPor   String?         @map("aprobado_por") @db.Uuid
  observaciones String?         @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")

  profesor Profesor? @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  empleado Empleado? @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  clasesSuspendidas ClaseSuspendida[]

  @@index([empleadoId])
  @@map("licencias")
}

model Solicitud {
  id          String           @id @default(uuid()) @db.Uuid
  tipo        tipo_solicitud
  alumnoId    String?          @map("alumno_id") @db.Uuid
  profesorId  String?          @map("profesor_id") @db.Uuid
  comentario  String           @db.Text
  estado      estado_solicitud @default(PENDIENTE)
  respuesta   String?          @db.Text
  resueltoPor String?          @map("resuelto_por") @db.Uuid
  resueltoAt  DateTime?        @map("resuelto_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  alumno   Alumno?   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  profesor Profesor? @relation(fields: [profesorId], references: [id], onDelete: Cascade)

  @@map("solicitudes")
}

// =========================================================
// M3.5 — Clases suspendidas y reasignaciones
// =========================================================

model ClaseSuspendida {
  id            String            @id @default(uuid()) @db.Uuid
  materiaId     String            @map("materia_id") @db.Uuid
  profesorId    String            @map("profesor_id") @db.Uuid
  fecha         DateTime          @db.Date
  horaInicio    String?           @map("hora_inicio")
  horaFin       String?           @map("hora_fin")
  motivo        motivo_suspension
  licenciaId    String?           @map("licencia_id") @db.Uuid
  observaciones String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")

  materia        Materia        @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  profesor       Profesor       @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  licencia       Licencia?      @relation(fields: [licenciaId], references: [id], onDelete: SetNull)
  reasignaciones Reasignacion[]

  @@unique([materiaId, profesorId, fecha, horaInicio])
  @@index([fecha])
  @@index([profesorId, fecha])
  @@map("clases_suspendidas")
}

model Reasignacion {
  id                String   @id @default(uuid()) @db.Uuid
  claseSuspendidaId String   @map("clase_suspendida_id") @db.Uuid
  profesorOrigenId  String   @map("profesor_origen_id") @db.Uuid
  profesorDestinoId String   @map("profesor_destino_id") @db.Uuid
  observaciones     String?  @db.Text
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  claseSuspendida ClaseSuspendida @relation(fields: [claseSuspendidaId], references: [id], onDelete: Cascade)
  profesorOrigen  Profesor        @relation("ReasignacionOrigen", fields: [profesorOrigenId], references: [id], onDelete: Cascade)
  profesorDestino Profesor        @relation("ReasignacionDestino", fields: [profesorDestinoId], references: [id], onDelete: Cascade)

  @@unique([claseSuspendidaId, profesorDestinoId])
  @@map("reasignaciones")
}

// =========================================================
// Personal no docente (bedeles, celadores, etc.)
// =========================================================

model Empleado {
  id                 String          @id @default(uuid()) @db.Uuid
  dni                String          @unique
  nombre             String
  apellido           String
  email              String          @unique
  telefono           String?
  fechaNacimiento    DateTime?       @map("fecha_nacimiento") @db.Date
  genero             String?
  domicilioCalle     String?         @map("domicilio_calle")
  domicilioNumero    String?         @map("domicilio_numero")
  domicilioCiudad    String?         @map("domicilio_ciudad")
  domicilioProvincia String?         @map("domicilio_provincia")
  domicilioCP        String?         @map("domicilio_cp")
  cargo              cargo_empleado
  sector             String?
  fechaIngreso       DateTime?       @map("fecha_ingreso") @db.Date
  observaciones      String?         @db.Text
  estado             estado_empleado @default(ACTIVO)
  createdAt          DateTime        @default(now()) @map("created_at")

  usuario        Usuario?
  horarios       HorarioTrabajo[]
  modificaciones ModificacionHorario[]
  licencias      Licencia[]

  @@map("empleados")
}

// Horario de trabajo de un empleado no docente.
// Cuando cambia un horario se cierra la fila (vigenteHasta) y se crea una nueva:
// asi queda el historial completo de turnos y sectores.
model HorarioTrabajo {
  id           String    @id @default(uuid()) @db.Uuid
  empleadoId   String    @map("empleado_id") @db.Uuid
  diaSemana    Int       @map("dia_semana")
  horaInicio   String    @map("hora_inicio")
  horaFin      String    @map("hora_fin")
  sector       String?
  vigenteDesde DateTime  @map("vigente_desde") @db.Date
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")

  empleado       Empleado              @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  modificaciones ModificacionHorario[]

  @@index([empleadoId, diaSemana])
  @@map("horarios_trabajo")
}

// Historial automatico de modificaciones de horario (lo genera el backend en cada ABM)
model ModificacionHorario {
  id            String                    @id @default(uuid()) @db.Uuid
  horarioId     String                    @map("horario_id") @db.Uuid
  empleadoId    String                    @map("empleado_id") @db.Uuid
  tipo          tipo_modificacion_horario
  detalle       String                    @db.Text
  valorAnterior Json?                     @map("valor_anterior")
  valorNuevo    Json?                     @map("valor_nuevo")
  motivo        String?                   @db.Text
  cambiadoPorId String?                   @map("cambiado_por_id") @db.Uuid
  visto         Boolean                   @default(false)
  vistoAt       DateTime?                 @map("visto_at")
  createdAt     DateTime                  @default(now()) @map("created_at")

  horario     HorarioTrabajo @relation(fields: [horarioId], references: [id], onDelete: Cascade)
  empleado    Empleado       @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  cambiadoPor Usuario?       @relation("HorariosModificados", fields: [cambiadoPorId], references: [id], onDelete: SetNull)

  @@index([empleadoId, createdAt])
  @@map("modificaciones_horario")
}
