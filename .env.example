# ============================================================
# Variables de entorno del backend
# Copiar a .env:   cp .env.example .env
# ============================================================

# Base de datos PostgreSQL (se publica en el puerto 5434)
DB_HOST=localhost
DB_PORT=5434
DB_USER=academico_user
DB_PASSWORD=cambiar_esta_password
DB_NAME=plataforma_academica

# Cadena de conexion que usa Prisma.
# OJO: si cambiás DB_PASSWORD tenés que cambiarlo TAMBIÉN acá.
DATABASE_URL=postgresql://academico_user:cambiar_esta_password@localhost:5434/plataforma_academica?schema=public

# Aplicacion
PORT=3000
NODE_ENV=development
JWT_SECRET=cambiar_este_valor_por_uno_largo_y_secreto
JWT_EXPIRES_IN=8h
