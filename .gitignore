# ============================================================
# .gitignore — ProyectoGemAdvanced
# ============================================================

# Dependencias
node_modules/

# Variables de entorno
.env
.env.local
.env.*.local
.env.bak

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Prisma (base de datos local)
prisma/*.db
prisma/*.db-journal

# Builds
dist/
build/
coverage/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Backups
*.bak
*.old
*.tmp

# Python (por si quedó algo)
__pycache__/
*.py[cod]
venv/
env/
