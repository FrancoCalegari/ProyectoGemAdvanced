# ============================================================
# .gitignore — ProyectoGemAdvanced
# ============================================================

# Dependencias
node_modules/

# Variables de entorno
.env
.env.local
.env.*.local
.env.bak

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Prisma (base de datos local)
prisma/*.db
prisma/*.db-journal

# Builds
dist/
build/
coverage/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Backups
*.bak
*.old
*.tmp

# Python (por si quedó algo)
__pycache__/
*.py[cod]
venv/
env/

# Backups de schema
*.backup

# Archivos de prueba
*.pdf
test_*.json

# ============================================================
# Reglas agregadas — limpieza de backups y temporales
# ============================================================

# Carpeta completa de backups del proyecto
backups/

# Backups de Prisma con sufijos (b1, b2, m1, ...)
*.backup-*
prisma/*.backup
prisma/*.backup-*
prisma/seed.js.backup

# Backups de otros archivos de config
*.bak.*
*~.backup

# Archivos temporales del proyecto
*.tmp.js
*.old.js

# Frontend (por ahora NO se sube)
# frontend/   <-- descomentar si querés ignorarlo entero
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*

# .env de backups
backups/**/.env
backups/**/.env.*

# Editor y OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
frontend/

# Scripts temporales de desarrollo
scripts_*.js
scripts_reset*.js

# Backups de frontend (bloqueo temporal)
*.construccion
*.funcional
*.original
